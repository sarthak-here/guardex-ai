# GuardEx SDK configuration. All variables are optional.
#
# Local in-process mode (the default) needs none of these:
#   pip install 'guardex[local]'
#   Guard()

# ── Server mode ────────────────────────────────────────────────────────
# Set either of these to route screening through a hosted GuardEx server
# instead of running models in-process.
# GUARDEX_BASE_URL=http://localhost:8001
# GUARDEX_API_KEY=

# ── Local mode tuning ──────────────────────────────────────────────────
# "safety" escalates uncertain cases to LlamaGuard via Ollama;
# "speed" stays ONNX-only.
# GUARDEX_CASCADE_MODE=safety

# Ollama endpoint for the LlamaGuard slow path (optional).
# GUARDEX_OLLAMA_URL=http://localhost:11434

# Hallucination/grounding check - downloads a ~700 MB NLI model on first use.
# GUARDEX_GROUNDING_ENABLED=0

# Where downloaded models are cached (~250 MB base footprint).
# GUARDEX_CACHE_DIR=~/.cache/guardex

# Pass through on ML/server errors instead of raising (default: fail closed).
# GUARDEX_FAIL_OPEN=0
